# Mitmproxy example: Modify response body
# Ported from mitmproxy/examples/addons/modify-response-body.py
#
# Usage:
#   lmscript examples/modify-response-body.lms build/modify-response-body.dslb
#   lminspect run --port 8080 --script build/modify-response-body.dslb

p = _dsl_ cli="lminspect" install="github:lmctl-ai/lminspect@latest";

# Standalone flow inspection & assertion
let f = inspect.new_flow("GET", "https://news.example.com/headlines");
f.respond(200, "Breaking: apples are trending across the tech sector!", "text/plain");

if (str_contains(f.response().text(), "apples")) {
    f.response().set_text(str_replace(f.response().text(), "apples", "oranges"));
}

assert(str_contains(f.response().text(), "oranges"), "response body replacement mismatch");
assert(!str_contains(f.response().text(), "apples"), "original string should be replaced");
println("PASS: modify-response-body demonstration verified");

# Addon hook for live proxy responses
@response
fn on_response(f: Flow) -> void implements ResponseHook {
    if (str_contains(f.response().text(), "apples")) {
        f.response().set_text(str_replace(f.response().text(), "apples", "oranges"));
    }
}

end _dsl_
savedsl(p, ARGV[0]);
