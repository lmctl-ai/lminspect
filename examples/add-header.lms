# Mitmproxy example: Add custom header
# Ported from mitmproxy/examples/addons/add-header.py
#
# Usage:
#   lmscript examples/add-header.lms build/add-header.dslb
#   lminspect run --port 8080 --script build/add-header.dslb

p = _dsl_ cli="lminspect" install="github:lmctl-ai/lminspect@latest";

# Standalone flow inspection & assertion
let f = inspect.new_flow("GET", "https://api.github.com/zen");
f.request().set_header("X-Proxy-By", "lminspect");
f.respond(200, "Approachable is better than simple.", "text/plain");
f.response().set_header("X-Custom-Header", "injected-value");

assert(f.request().header("x-proxy-by") == "lminspect", "request header mismatch");
assert(f.response().header("x-custom-header") == "injected-value", "response header mismatch");
println("PASS: add-header demonstration verified");

# Addon hooks executed during live proxy interception
@request
fn on_request(f: Flow) -> void implements RequestHook {
    f.request().set_header("X-Proxy-By", "lminspect");
}

@response
fn on_response(f: Flow) -> void implements ResponseHook {
    f.response().set_header("X-Powered-By", "lminspect");
}

end _dsl_
savedsl(p, ARGV[0]);
